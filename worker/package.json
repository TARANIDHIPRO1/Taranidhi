{
  "name": "occultviision-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute occultviision-db --local --file=../db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute occultviision-db --remote --file=../db/schema.sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/jest": "^30.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  }
}
